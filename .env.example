# ─── Django ───────────────────────────────────────────────────
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-please-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Пока нет HTTPS — оставить пустым. В 7.3 впишем https://<домен>.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Пути перекрываются в docker-compose.yml, здесь для локального запуска.
# DJANGO_DB_PATH=
# DJANGO_MEDIA_ROOT=

# ─── Active Directory (заморожено, не включать до отдельного патча) ───
AD_ENABLED=0
AD_SERVER=dc.corp.local
AD_DOMAIN=CORP
AD_USER_BASE=ou=users,dc=corp,dc=local
AD_MAIL_DOMAIN=eag.su

ALLOWED_EMAIL_DOMAINS=eag.su

# ─── Регистрация ──────────────────────────────────────────────
REGISTRATION_OPEN=0

# ─── Почта ────────────────────────────────────────────────────
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMTP_HOST=smtp.eag.su
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=noreply@eag.su
SMTP_PASS=
SUPPORT_EMAIL=admin@eag.su

# ─── Планировщик в контейнере (пилот) ─────────────────────────
RUN_SCHEDULER=1
